{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "clients": {
      ".indexOn": ["cpf", "fullName", "createdAt"]
    },
    "loans": {
      ".indexOn": ["clientId", "status", "dueDate", "createdAt"]
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.admin === true || auth.token.email === 'admin@credicontrol.com')"
    },
    "audit_logs": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.admin === true || auth.token.email === 'admin@credicontrol.com')",
      ".write": "auth != null"
    }

  }
}
