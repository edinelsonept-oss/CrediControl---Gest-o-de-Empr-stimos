{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "clients": {
      ".indexOn": ["cpf", "fullName", "createdAt"]
    },
    "loans": {
      ".indexOn": ["clientId", "status", "dueDate", "createdAt"]
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'edinelsonept@gmail.com'"
    },
    "audit_logs": {
      ".read": "auth != null && auth.token.email === 'edinelsonept@gmail.com'",
      ".write": "auth != null"
    }
  }
}
