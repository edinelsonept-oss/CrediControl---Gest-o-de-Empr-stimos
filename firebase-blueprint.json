{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Borrower client profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "cpfCnpj": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["fullName", "cpfCnpj"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Loan contract details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "principalAmount": { "type": "number" },
        "interestRatePercent": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["clientId", "principalAmount"]
    },
    "Settings": {
      "title": "Settings",
      "description": "System configuration",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyPhone": { "type": "string" }
      }
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee user account created by Administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "roleTitle": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "role", "status"]
    }
  },
  "firestore": {
    "clients": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Collection of borrower clients"
    },
    "loans": {
      "schema": { "$ref": "#/entities/Loan" },
      "description": "Collection of loan contracts"
    },
    "employees": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Collection of employee users created by administrator"
    },
    "settings": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "System configuration documents"
    }
  }
}
