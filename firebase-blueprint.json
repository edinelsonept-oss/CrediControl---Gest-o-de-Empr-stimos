{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Borrower client profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "cpfCnpj": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["fullName", "cpfCnpj"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Loan contract details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "principalAmount": { "type": "number" },
        "interestRatePercent": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["clientId", "principalAmount"]
    },
    "Settings": {
      "title": "Settings",
      "description": "System configuration",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companyPhone": { "type": "string" }
      }
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee user account and registration applications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "roleTitle": { "type": "string" },
        "phone": { "type": "string" },
        "cpf": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "birthDate": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "registrationMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "decisionReason": { "type": "string" },
        "decidedBy": { "type": "string" },
        "decidedAt": { "type": "string" }
      },
      "required": ["name", "email", "status"]
    },
    "EmployeeNotification": {
      "title": "EmployeeNotification",
      "description": "System and administrative notification for employees",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "employeeEmail": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" },
        "actionLabel": { "type": "string" }
      },
      "required": ["employeeId", "title", "message", "type", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable audit trail of security and business actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userRole": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "entityType", "entityId", "userId", "timestamp"]
    }
  },
  "firestore": {
    "clients": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Collection of borrower clients"
    },
    "loans": {
      "schema": { "$ref": "#/entities/Loan" },
      "description": "Collection of loan contracts"
    },
    "employees": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Collection of employee users created by administrator"
    },
    "employee_notifications": {
      "schema": { "$ref": "#/entities/EmployeeNotification" },
      "description": "Collection of in-app notifications sent to employees regarding their approval status"
    },
    "settings": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "System configuration documents"
    },
    "audit_logs": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only immutable audit log collection for security and compliance"
    }
  }
}
