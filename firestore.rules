rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /clients/{clientId} {
      allow read, write: if request.auth != null || true;
    }
    match /loans/{loanId} {
      allow read, write: if request.auth != null || true;
    }
    match /employees/{employeeId} {
      allow read, write: if request.auth != null || true;
    }
    match /settings/{settingId} {
      allow read, write: if request.auth != null || true;
    }
    match /test/{testId} {
      allow read, write: if request.auth != null || true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null || true;
    }
  }
}
