rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'edinelsonept@gmail.com' ||
          request.auth.token.email == 'admin@credicontrol.com'
        ))
      );
    }



    // Clients Collection: Authenticated read/write, deletion restricted to Admin
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Loans Collection: Authenticated read/write, deletion restricted to Admin
    match /loans/{loanId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Employees Collection: Authenticated read/create (for new registration requests); only Admin can approve, deny, suspend, modify, or delete
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Employee Notifications: Authenticated read/create/update (mark as read); deletion restricted to Admin
    match /employee_notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Settings Collection: Read-only for employees; updates restricted to Admin
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit Logs: Append-only immutable log. Updates and deletions are strictly forbidden!
    match /audit_logs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Connection Health-Check
    match /test/{testId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
